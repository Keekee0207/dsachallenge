# 50 Days DSA Challenge Tracker - Environment Configuration
# Copy this file to .env.local and update with your Supabase credentials.

# Supabase PostgreSQL Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Challenge Config
NEXT_PUBLIC_CHALLENGE_START_DATE=2026-11-21
NEXT_PUBLIC_CHALLENGE_END_DATE=2027-01-09
NEXT_PUBLIC_TIMEZONE=Asia/Kolkata
